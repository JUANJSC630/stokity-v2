    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write \"resources/\" \"*.{ts,json}\" && ./vendor/bin/pint",
        "format:check": "prettier --check \"resources/\" \"*.{ts,json}\" && ./vendor/bin/pint --test",
        "format:php": "./vendor/bin/pint",
        "format:js": "prettier --write \"resources/\" \"*.{ts,json}\"",
        "lint": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "types": "tsc --noEmit"
    },
